# Development-only example. Generate fresh random 32-byte base64 secrets.
NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
PUBLIC_ORIGIN=http://localhost:8443
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
DATABASE_ROLE=gei_backend
AUTH_CODE_PEPPER=REPLACE_WITH_BASE64_32_RANDOM_BYTES
EMAIL_CHANGE_CODE_PEPPER=REPLACE_WITH_BASE64_32_RANDOM_BYTES
CSRF_HMAC_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES
RATE_LIMIT_KEY_PEPPER=REPLACE_WITH_BASE64_32_RANDOM_BYTES
CLUB_TIME_ZONE=America/Argentina/Buenos_Aires
METRICS_ENABLED=true
REALTIME_ENABLED=true
