{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <13"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev:backend": "tsx watch --env-file-if-exists=.env backend/src/main.ts",
    "build": "vite build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config backend/vitest.config.ts unit.test",
    "test:integration": "node scripts/test-db.mjs prepare && vitest run --config backend/vitest.config.ts integration.test",
    "test:api": "node scripts/test-db.mjs prepare && vitest run --config backend/vitest.config.ts api.test",
    "test:all": "pnpm test && pnpm test:unit && pnpm test:integration && pnpm test:api",
    "db:start": "node scripts/db-local.mjs start",
    "db:reset": "node scripts/db-local.mjs reset",
    "db:types": "node scripts/db-local.mjs types",
    "db:stop": "node scripts/db-local.mjs stop"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.44.0",
    "fastify": "^5.6.1",
    "kysely": "^0.28.8",
    "lucide-react": "^1.50.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.1",
    "jszip": "^3.10.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.3"
  }
}
