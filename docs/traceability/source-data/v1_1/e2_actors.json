      "id": "ACT-UNAUTHENTICATED",
      "name": "Persona no autenticada",
      "description": "Persona externa que interactúa con GEI sin sesión; puede autenticarse o consumir un código de un solo uso; sin fuente de autoridad de dominio."
    },
    {
      "id": "ACT-AUTHENTICATED",
      "name": "Persona autenticada",
      "description": "Actor abstracto no instanciable: capacidad común de toda persona con Account ACTIVE y sesión vigente; no concede acceso a la aplicación por sí solo."
    },
    {
      "id": "ACT-PLAYER",
      "name": "Jugadora",
      "description": "Persona con RoleAssignment PLAYER vigente sobre un equipo dentro de Membership vigente; responde su propia disponibilidad."
    },
    {
      "id": "ACT-CAPTAIN",
      "name": "Capitana",
      "description": "Persona con RoleAssignment CAPTAIN vigente; actor independiente con autoridad propia sobre la logística de su equipo (scope TEAM)."
    },
    {
      "id": "ACT-COACH",
      "name": "Entrenador/a",
      "description": "Persona con RoleAssignment COACH vigente (scope TEAM o EVENT); autoridad deportiva sobre eventos, convocatoria, asistencia y resultado."
    },
    {
      "id": "ACT-SUBCOMMITTEE",
      "name": "Subcomisión de hockey",
      "description": "Persona con RoleAssignment SUBCOMMITTEE vigente (scope CLUB); autoridad oficial: comunicados, competencias."
    },
    {
      "id": "ACT-ADMIN",
      "name": "Administración del club",
      "description": "Persona con RoleAssignment ADMIN vigente (scope CLUB); autoridad administrativa sobre identidad, cuentas, estructura y auditoría; sin autoridad deportiva."
    }
  ],
