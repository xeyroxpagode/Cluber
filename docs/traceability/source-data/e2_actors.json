    },
    {
      "id": "ACT-CAPTAIN",
      "name": "Capitana",
      "description": "Persona con RoleAssignment CAPTAIN vigente; actor independiente con autoridad propia sobre la logística de su equipo (scope TEAM)."
    },
    {
