      "name": "Entrenador/a",
      "description": "Persona con RoleAssignment COACH vigente (scope TEAM o EVENT); autoridad deportiva sobre eventos, convocatoria, asistencia y resultado."
    },
    {
      "id": "ACT-SUBCOMMITTEE",
      "name": "Subcomisión de hockey",
      "description": "Persona con RoleAssignment SUBCOMMITTEE vigente (scope CLUB); autoridad oficial: comunicados, habilitación y competencias."
    },
    {
      "id": "ACT-ADMIN",
      "name": "Administración del club",
      "description": "Persona con RoleAssignment ADMIN vigente (scope CLUB); autoridad administrativa sobre identidad, cuentas, estructura y auditoría; sin autoridad deportiva."
    },
