        <mxCell id="identity-note" value="Identidad de Team = Season + Division + Line (única inmutable)&#xA;Combinación única: {seasonId, divisionId, lineId}&#xA;Nombre derivado, no almacenado&#xA;Renombrar Division/Line con Teams activos → RECHAZADO (REQ-PPL-014)&#xA;Archivar con dependencias activas → RECHAZADO nombrando dependencia (REQ-STR-006)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="245" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="venue-rules" value="Regla A/B Venue (PT §11):&#xA;A) Corregir metadatos Venue (nombre, dirección, field_label) → NO reprograma Events, NO coordinationRevision++, NO notifica, NO NEEDS_RECONFIRMATION&#xA;B) Cambiar venue DE un Event (Event.venueId) → SÍ es cambio material completo&#xA;Identidad de Venue estable por ID (archivedAt para lifecycle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="365" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="invariants" value="Invariantes Clave:&#xA;● Season: histórica, sin estado, no hard-delete (REQ-STR-001)&#xA;● Division/Line: ACTIVE→ARCHIVED terminal en V1 (DEF-STR-001/002 defer)&#xA;● Team: DRAFT→ACTIVE→ARCHIVED; identidad inmutable; valla dependencias&#xA;● Subcomisión denegada en estructura (REQ-STR-009)&#xA;● Referencias por ID, no por nombre (REQ-STR-011)&#xA;● Estructura seleccionable de listas (REQ-STR-013)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="475" width="400" height="140" as="geometry" />
        </mxCell>
