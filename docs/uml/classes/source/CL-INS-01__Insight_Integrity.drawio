        <mxCell id="lbl1" value="0..*" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="277" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl2" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="24" y="332" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="invariants" value="Invariantes Críticas (PT §25, REQ-INS-008 a 012):&#xA;● AuditEntry: append-only; qué cambió, quién, cuándo, motivo, enlace al objeto&#xA;● Datos sensibles redactados en diff; SIN secrets (passwords, hashes, tokens, cookies, cuerpos)&#xA;● Solo Admin consulta auditoría (filtros por rango fechas y actor)&#xA;● History: se deriva de entidades origen + auditoría; NO tabla genérica ni timeline personal&#xA;● History: correcciones asistencia/resultado, revisiones convocatoria, historial evento, correcciones comunicado, estado mensaje&#xA;● Reports: proyecciones read-only; alcance por autoridad (propio/equipo/club)&#xA;● Attendance Report: Admin NO accede (PT §5); cada fila enlaza al origen&#xA;● Performance Report: matches_played derivado de resultado, no asistencia; cada fila enlaza al partido&#xA;● Search: proyección read-only; PII por field authority; 'sin consulta' ≠ 'cero resultados'&#xA;● Proyecciones NO son dueñas de datos (REQ-SYS-019): Inicio, Calendario, Equipos, Búsqueda, Informes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="555" width="550" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Fuentes:&#xA;PT §25 (tabla 41)&#xA;REQ-INS-001 a 012&#xA;UC-INS-01 a 05&#xA;R-58" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="755" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note-sm" value="NOTA: History, Report, Search NO tienen state machine.&#xA;Son proyecciones derivadas (read-only), no entidades persistidas con lifecycle.&#xA;E6 §3: 'NO_STATE_MACHINE' para estos conceptos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="755" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note-pii" value="PII Field Authority (PT §6, REQ-PPL-011):&#xA;● Campo no autorizado NO existe en respuesta (no se oculta en pantalla)&#xA;● DNI: solo ADMIN&#xA;● Fecha nacimiento completa: solo ADMIN&#xA;● Tel/Email: self, ADMIN, COACH/CAPTAIN team actual si necesidad operativa&#xA;● Guardian: ve nombre, equipo, eventos, disponibilidad del menor; NO DNI, NO DOB, NO eligibility reason/source, NO chats privados, NO auditoría&#xA;● ADMIN NO lee chats privados por ser ADMIN (regla Nunca)&#xA;● CAPTAIN NO ve DNI por pertenecer al Team (regla Nunca)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="755" width="480" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>