        <mxCell id="rel-history-domain" style="edgeStyle=orthogonalEdgeStyle;edge;whiteSpace=wrap;html=1;strokeColor=#37474F;strokeWidth=1;endArrow=open;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.37;entryDx=0;entryDy=0;" edge="1" source="svc-history" target="domain-classes" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="150" />
