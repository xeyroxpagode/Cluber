        <mxCell id="rel-report-domain" style="edgeStyle=orthogonalEdgeStyle;edge;whiteSpace=wrap;html=1;strokeColor=#37474F;strokeWidth=1;endArrow=open;dashed=1;exitX=0;exitY=0.83;exitDx=0;exitDy=0;entryX=1;entryY=0.17;entryDx=0;entryDy=0;" edge="1" source="svc-report" target="domain-classes" parent="1">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="rel-search-domain" style="edgeStyle=orthogonalEdgeStyle;edge;whiteSpace=wrap;html=1;strokeColor=#37474F;strokeWidth=1;endArrow=open;dashed=1;exitX=0.23;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.63;entryDx=0;entryDy=0;" edge="1" source="svc-search" target="domain-classes" parent="1">
