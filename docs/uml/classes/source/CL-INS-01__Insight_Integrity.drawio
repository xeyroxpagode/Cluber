  <diagram id="CL-INS-01" name="CL-INS-01__Insight_Integrity">
    <mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="935" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="INS — Insight &amp; Integrity (Class Diagram)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1129" height="40" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;&lt;canonical&gt;&gt; AuditEntry&#xA;+ id: UUID {id}&#xA;+ occurredAt: DateTime&#xA;+ actorPersonId: UUID&#xA;+ action: String (vocabulario canónico)&#xA;+ targetType: String&#xA;+ targetId: UUID&#xA;+ reason: String?&#xA;+ diff: JSON (datos sensibles redactados)&#xA;(append-only; sin contraseñas/hashes/tokens/cookies/cuerpos)&#xA;+ AuditEntry(actorPersonId, action, targetType, targetId, reason?, diff?)&#xA;/ actor: Person&#xA;(Solo Admin consulta; filtros por rango fechas y actor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="450" height="225" as="geometry" />
        </mxCell>
        <mxCell id="svc-history" value="&lt;&lt;service&gt;&gt; History&#xA;● Derivada de entidades origen + AuditEntry&#xA;● Correcciones asistencia/resultado&#xA;● Revisiones convocatoria (SelectionRevision)&#xA;● Historial evento (Event.state changes)&#xA;● Correcciones comunicado (Announcement)&#xA;● Estado mensaje (Message.state)&#xA;● Con fecha real y actor&#xA;● NO tabla genérica ni timeline personal (REQ-INS-012)&#xA;● Por superficie (UC-INS-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=1;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="svc-report" value="&lt;&lt;service&gt;&gt; Report&#xA;● Attendance Report (UC-INS-02)&#xA;  - PRESENT/ABSENT/JUSTIFIED/UNRECORRED&#xA;  - Alcance: propio / equipo / club&#xA;  - Jugadora ve lo suyo; Admin NO accede (PT §5)&#xA;  - Cada fila enlaza al origen (AttendanceEntry/Sheet)&#xA;● Performance Report (UC-INS-03)&#xA;  - Basado en MatchRecord (PLAYED)&#xA;  - matches_played derivado de resultado, no asistencia&#xA;  - Jugadora ve lo suyo&#xA;  - Cada fila enlaza al partido&#xA;● Período aplicado visible y modificable (REQ-INS-006)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=1;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="300" height="205" as="geometry" />
        </mxCell>
        <mxCell id="svc-search" value="&lt;&lt;service&gt;&gt; Search&#xA;● Cubre: personas, equipos, eventos, divisiones/líneas&#xA;● 'Sin consulta' ≠ 'cero resultados' (REQ-INS-001)&#xA;● Vacío con siguiente paso&#xA;● PII por field authority (REQ-INS-002, REQ-PPL-011)&#xA;● Estructura por división y línea (no texto libre)&#xA;● Consulta sobrevive a back navigation (REQ-INS-003)&#xA;● Proyección read-only (no dueña de datos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=1;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="60" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="person" value="&lt;&lt;ref&gt;&gt; Person&#xA;+ id: UUID {id}&#xA;+ firstName: String&#xA;+ lastName: String" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#606060;strokeWidth=1;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="295" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="domain-classes" value="&lt;&lt;ref&gt;&gt; Clases de Dominio (fuente de History/Report/Search)&#xA;Event, MatchRecord, PlayerMatchStats, AttendanceEntry/Sheet,&#xA;SelectionRevision, Announcement, Message, Conversation,&#xA;TeamAssignment, RoleAssignment, GuardianRelationship,&#xA;Team, Division, Line, Season, Venue,&#xA;Competition, CompetitionEntry, EligibilityConstraint,&#xA;Person, Account, Membership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#606060;strokeWidth=1;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="395" width="460" height="150" as="geometry" />
        </mxCell>
