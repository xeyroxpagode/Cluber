        <mxCell id="notification" value="&lt;&lt;canonical&gt;&gt; Notification&#xA;+ id: UUID {id}&#xA;+ recipientPersonId: UUID&#xA;+ type: NotifType (7 tipos)&#xA;+ resourceType: String (EVENT/SELECTION/ANNOUNCEMENT)&#xA;+ resourceId: UUID&#xA;+ originEventId: UUID?&#xA;+ title: String&#xA;+ body: String&#xA;+ occurredAt: DateTime&#xA;+ readAt: DateTime?&#xA;+ audienceResolvedAt: DateTime (inmutable)&#xA;/ isUnread: Boolean (readAt = NULL)&#xA;+ Notification(recipientPersonId, type, resourceType, resourceId, originEventId?, title, body, occurredAt, audienceResolvedAt)&#xA;+ markRead()&#xA;(Clave lógica única: originEventId + recipient + type; deduplicación)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
