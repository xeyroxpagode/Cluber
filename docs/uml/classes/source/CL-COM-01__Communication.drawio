        <mxCell id="announcement" value="&lt;&lt;canonical&gt;&gt; Announcement&#xA;+ id: UUID {id}&#xA;+ title: String&#xA;+ body: String&#xA;+ state: AnnState (DRAFT/PUBLISHED/ARCHIVED)&#xA;+ publishedAt: DateTime?&#xA;+ publishedByPersonId: UUID?&#xA;+ archivedAt: DateTime?&#xA;/ targetTeams: Team[0..*] (TEAM_SET real)&#xA;/ clubWide: Boolean&#xA;/ audienceSnapshot: Team[0..*] (inmutable al publicar)&#xA;+ Announcement(title, body, targetTeamIds, clubWide, authorPersonId)&#xA;+ publish(subcommitteePersonId): Boolean&#xA;+ correct(title?, body?, reason, subcommitteePersonId)&#xA;+ archive(subcommitteePersonId): Boolean&#xA;/ isAccessibleBy(person): Boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="380" height="260" as="geometry" />
        </mxCell>
        <mxCell id="anntarget" value="&lt;&lt;associationClass&gt;&gt; AnnouncementTargetTeam&#xA;+ id: UUID {id}&#xA;+ announcementId: UUID&#xA;+ teamId: UUID&#xA;(Announcement 0..* ◇— 0..* Team; audiencia snapshot inmutable)&#xA;Solo Subcomisión gestiona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="conversation" value="&lt;&lt;canonical&gt;&gt; Conversation&#xA;+ id: UUID {id}&#xA;+ type: ConvType (DIRECT/GROUP/TEAM/EVENT)&#xA;+ title: String? (req GROUP; derivado TEAM/EVENT)&#xA;+ state: ConvState (ACTIVE/ARCHIVED; solo GROUP)&#xA;+ directPairKey: DirectPairKey? (solo DIRECT, unique)&#xA;+ teamId: UUID? (solo TEAM, unique)&#xA;+ eventId: UUID? (solo EVENT, unique)&#xA;+ createdAt: DateTime&#xA;+ createdByPersonId: UUID&#xA;/ participants: Person[0..*]&#xA;/ messages: Message[0..*]&#xA;+ Conversation(type, title?, teamId?, eventId?, creatorPersonId, initialParticipants)&#xA;+ addParticipant(personId, joinedAt)&#xA;+ removeParticipant(personId, leftAt)&#xA;+ archive(participantPersonId): Boolean (solo GROUP)&#xA;/ canParticipantRead(personId, atDateTime): Boolean&#xA;/ hasCommunicationEntitlement(person): Boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="convparticipant" value="&lt;&lt;associationClass&gt;&gt; ConversationParticipant&#xA;+ id: UUID {id}&#xA;+ conversationId: UUID&#xA;+ personId: UUID&#xA;+ joinedAt: DateTime&#xA;+ leftAt: DateTime?&#xA;/ isActive: Boolean (leftAt = NULL)&#xA;(Person 0..* ◇— 0..* Conversation)&#xA;Acceso temporal: joinedAt ≤ atDateTime &lt; (leftAt ∧ ∞)&#xA;Sin historia anterior a joinedAt; ex-participante conserva período&#xA;Admin sin participación NO lee (REQ-COM-011)&#xA;DIRECT: par canónico único (directPairKey partial unique)&#xA;GROUP: ≥2, título, archivable, múltiples&#xA;TEAM: 0..1 canónica por Team, membresía sync&#xA;EVENT: 0..1 canónica por Event, membresía sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="380" height="245" as="geometry" />
        </mxCell>
        <mxCell id="message" value="&lt;&lt;canonical&gt;&gt; Message&#xA;+ id: UUID {id}&#xA;+ conversationId: UUID&#xA;+ authorPersonId: UUID&#xA;+ body: String&#xA;+ state: MsgState (SENT/EDITED/DELETED)&#xA;+ sentAt: DateTime&#xA;+ editedAt: DateTime?&#xA;+ deletedAt: DateTime?&#xA;+ deletionReason: String?&#xA;+ Message(conversationId, authorPersonId, body)&#xA;+ edit(newBody, authorPersonId): Boolean&#xA;+ delete(authorPersonId, reason): Boolean&#xA;/ isOwn(personId): Boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="460" width="370" height="235" as="geometry" />
