        <mxCell id="event" value="&lt;&lt;canonical&gt;&gt; Event&#xA;+ id: UUID {id}&#xA;+ type: EventType&#xA;+ title: String&#xA;+ startAt: DateTime?&#xA;+ endAt: DateTime?&#xA;+ timeZone: String&#xA;+ venueId: UUID?&#xA;+ state: EventState&#xA;+ clubWideTarget: Boolean&#xA;+ seriesId: UUID?&#xA;+ occurrenceIndex: Integer?&#xA;+ coordinationRevision: Integer&#xA;+ creatorPersonId: UUID&#xA;+ createdAt: DateTime&#xA;+ updatedAt: DateTime&#xA;+ version: Integer&#xA;/ targetTeams: Team[0..*]&#xA;/ targetPersons: Person[0..*]&#xA;/ logistics: EventLogistics[0..1]&#xA;/ match: Match[0..1]&#xA;/ attendanceSheet: AttendanceSheet[0..1]&#xA;/ availabilityResponses: Availability[0..*]&#xA;/ selection: Selection[0..1]&#xA;/ matchRecord: MatchRecord[0..1]&#xA;/ jornada: Jornada[0..1]&#xA;+ Event(type, title, startAt?, endAt?, timeZone, venueId?, clubWideTarget, targetTeams, targetPersons, creatorPersonId)&#xA;+ schedule(startAt, endAt, venueId?): Boolean&#xA;+ editNonMaterial(title?, metadata)&#xA;+ proposeMaterialChange(changes): ImpactPreviewToken&#xA;+ executeMaterialChange(token, confirmedChanges): Boolean&#xA;+ postpone(reason): Boolean&#xA;+ resume(newStartAt, newEndAt, newVenueId?): Boolean&#xA;+ cancel(reason): Boolean&#xA;+ restore(): Boolean&#xA;+ start(): Boolean&#xA;+ complete(): Boolean&#xA;+ abandon(reason): Boolean&#xA;+ resolveConcurrencyConflict(baseVersion, localDraft, serverVersion)&#xA;+ updateLogistics(logistics)&#xA;/ isScheduled(): Boolean&#xA;/ acceptsAvailability(): Boolean&#xA;/ getTargetPersons(): Person[0..*]&#xA;/ getConcreteTeam(): Team?&#xA;- validateInvariants(): Boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="400" height="665" as="geometry" />
        </mxCell>
        <mxCell id="match" value="&lt;&lt;canonical&gt;&gt; Match (subtipo type=MATCH)&#xA;+ eventId: UUID {id}{fk}&#xA;+ opponent: String&#xA;+ competitionEntryId: UUID?&#xA;+ meetingAt: DateTime?&#xA;+ departureAt: DateTime?&#xA;+ meetingPoint: String?&#xA;+ transportNote: String?&#xA;+ arrivalInstructions: String?&#xA;/ concreteTeam: Team (único target, inmutable si SCHEDULED)&#xA;+ Match(eventId, opponent)&#xA;+ updateLogistics(meetingAt?, departureAt?, meetingPoint?, transportNote?, arrivalInstructions?)&#xA;/ getCompetitionEntry(jornada): CompetitionEntry?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
