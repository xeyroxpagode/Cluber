        <mxCell id="invariants" value="Invariantes Clave:&#xA;● Person ≠ Account ≠ Membership ≠ TeamAssignment ≠ RoleAssignment ≠ GuardianRelationship (separadas)&#xA;● TeamAssignment = afiliación PLAYER (solo); Coach usa RoleAssignment (PT §17)&#xA;● RoleAssignment: 5 roles × scopes válidos (PT §5); combinación inválida → INVALID_ROLE_SCOPE&#xA;● Multi-rol = unión de RoleAssignment vigentes (no herencia)&#xA;● GuardianRelationship: delegación (no rol); 2 flags independientes; individual por menor&#xA;● Guardian no requiere Membership; no otorga rol deportivo; no accesorio comunicacional&#xA;● Asignar jugadora: atómico TeamAssignment + RoleAssignment PLAYER (PT §17)&#xA;● Cambiar equipo: cierra anterior + crea nuevo; CAPTAIN NO se transfiere (PT §17)&#xA;● Retirar jugadora: cierra TeamAssignment + PLAYER + CAPTAIN si existía (PT §17)&#xA;● Finalizar Membership con dependencias activas → rechazado (REQ-PPL-004)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="400" width="350" height="280" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Fuentes:&#xA;PT §5, §17, §20, §25&#xA;REQ-PPL-001 a 016&#xA;UC-PPL-01 a 17&#xA;SM (temporal model E6 §3)&#xA;R-03 a R-09" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="700" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note-ac" value="Nota: TeamAssignment, RoleAssignment y GuardianRelationship son clases canónicas que TAMBIÉN funcionan como clases de asociación N:M con identidad, atributos y vigencia propia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="760" width="750" height="60" as="geometry" />
        </mxCell>
